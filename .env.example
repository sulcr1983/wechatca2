# ===== 必填：LLM 服务（用于 AI 排版、润色、摘要）=====
# 支持阿里云百炼、OpenAI、DeepSeek 等兼容 API
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxx
LLM_MODEL=qwen-plus

# ===== 必填：文生图服务（用于标题图背景生成）=====
# 可选，不配置则自动使用纯色渐变背景
IMAGE_GEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_GEN_API_KEY=sk-xxxxx
IMAGE_GEN_MODEL=wanx-v1

# ===== 可选：自定义端口 =====
PORT=5000

# ===== 可选：联网搜图（小红书封面「底图 → 联网搜图」）=====
# Pexels 免费申请：https://www.pexels.com/api/  商用免署名，一个 Key 就够
PEXELS_API_KEY=

# ===== 可选：AI 平台预设（PWA 侧 BYOK 用；本地脚本测试也会读）=====
# 与 LLM_* 等价，保留两套是因为历史脚本各读一套；线上用户 Key 存浏览器，不读这里
AI_URL=https://api.deepseek.com
AI_API_KEY=sk-xxxxx
AI_MODEL=deepseek-chat
AI_PLATFORM_ID=deepseek
AI_IMAGE_MODEL=

# ===== 发布用：GitHub / Cloudflare（release.py / deploy.sh 读取，勿提交）=====
GITHUB_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
