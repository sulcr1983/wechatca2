{
  "name": "霓虹",
  "description": "深紫底配霓粉青蓝，八零年代电子梦。适合音乐、潮流、亚文化。",
  "colors": {
    "primary": "#EFE6FF",
    "accent": "#FF5FA2",
    "background": "#1A0D2E",
    "blockquote_bg": "rgba(255,95,162,0.04)",
    "code_bg": "#0E0719",
    "hr_color": "#A49AB6",
    "footnote_bg": "rgba(255,95,162,0.03)"
  },
  "styles": {
    "wrapper": {
      "background_color": "#1A0D2E",
      "padding": "16px",
      "font_family": "-apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif"
    },
    "h1": {
      "font_size": "25px",
      "font_weight": "800",
      "color": "#EFE6FF",
      "text_align": "center",
      "line_height": "1.35",
      "letter_spacing": "0.4em",
      "margin_top": "8px",
      "margin_bottom": "20px",
      "padding": "0"
    },
    "h2": {
      "font_size": "20px",
      "font_weight": "800",
      "color": "#EFE6FF",
      "line_height": "1.35",
      "letter_spacing": "0.4em",
      "margin_top": "32px",
      "margin_bottom": "14px",
      "padding": "0"
    },
    "h3": {
      "font_size": "17px",
      "font_weight": "700",
      "color": "#FF5FA2",
      "line_height": "1.4",
      "margin_top": "26px",
      "margin_bottom": "10px",
      "padding": "0"
    },
    "h4": {
      "font_size": "16px",
      "font_weight": "700",
      "color": "#EFE6FF",
      "line_height": "1.4",
      "margin_top": "22px",
      "margin_bottom": "8px"
    },
    "h5": {
      "font_size": "15px",
      "font_weight": "600",
      "color": "#A49AB6",
      "line_height": "1.4",
      "margin_top": "20px",
      "margin_bottom": "6px"
    },
    "h6": {
      "font_size": "14px",
      "font_weight": "600",
      "color": "#A49AB6",
      "line_height": "1.4",
      "margin_top": "18px",
      "margin_bottom": "6px"
    },
    "p": {
      "font_size": "16px",
      "color": "#EFE6FF",
      "line_height": "1.9",
      "letter_spacing": "0.4px",
      "text_align": "justify",
      "margin_top": "0",
      "margin_bottom": "20px"
    },
    "strong": {
      "font_weight": "700",
      "color": "#5FE0FF"
    },
    "em": {
      "font_style": "italic",
      "color": "#A49AB6"
    },
    "a": {
      "color": "#FF5FA2",
      "text_decoration": "none",
      "border_bottom": "1px solid rgba(255,95,162,0.5)"
    },
    "blockquote": {
      "border_left": "3px solid #FF5FA2",
      "background": "rgba(255,95,162,0.04)",
      "color": "#A49AB6",
      "font_size": "15px",
      "line_height": "1.8",
      "padding": "14px 18px",
      "margin_top": "22px",
      "margin_bottom": "22px",
      "border_radius": "0 14px 14px 0"
    },
    "blockquote_p": {
      "font_size": "15px",
      "color": "#A49AB6",
      "line_height": "1.8",
      "margin_bottom": "0",
      "background": "transparent",
      "font_style": "normal"
    },
    "img": {
      "max_width": "100%",
      "display": "block",
      "border_radius": "14px",
      "margin_top": "10px",
      "margin_bottom": "10px"
    },
    "img_wrapper": {
      "background": "rgba(239,230,255,0.03)",
      "border_radius": "14px",
      "padding": "4px",
      "margin_top": "12px",
      "margin_bottom": "12px"
    },
    "hr": {
      "border": "none",
      "height": "1px",
      "background": "#382B4B",
      "margin_top": "30px",
      "margin_bottom": "30px"
    },
    "code": {
      "background": "rgba(255,95,162,0.09)",
      "color": "#5FE0FF",
      "padding": "3px 7px",
      "border_radius": "5px",
      "font_size": "90%",
      "font_family": "'SF Mono', Menlo, Consolas, 'Courier New', monospace"
    },
    "code_block": {
      "background": "#0E0719",
      "border_radius": "12px",
      "margin_top": "22px",
      "margin_bottom": "22px",
      "overflow": "hidden"
    },
    "code_header": {
      "display": "flex",
      "align_items": "center",
      "height": "36px",
      "padding": "0 12px",
      "background": "#0E0719"
    },
    "pre": {
      "background": "#0E0719",
      "color": "#F3ECFF",
      "padding": "18px",
      "border_radius": "0",
      "overflow_x": "auto",
      "margin_top": "0",
      "margin_bottom": "0",
      "font_size": "13.5px",
      "line_height": "1.6",
      "white_space": "pre-wrap",
      "word_wrap": "break-word",
      "word_break": "break-all"
    },
    "pre_code": {
      "background": "none",
      "padding": "0",
      "color": "#F3ECFF",
      "font_size": "13.5px",
      "font_family": "'SF Mono', Menlo, Consolas, 'Courier New', monospace"
    },
    "table": {
      "width": "100%",
      "border_collapse": "separate",
      "border_spacing": "0",
      "border": "1px solid #382B4B",
      "border_radius": "14px",
      "overflow": "hidden",
      "font_size": "14px",
      "margin_top": "18px",
      "margin_bottom": "18px"
    },
    "th": {
      "background": "rgba(255,95,162,0.08)",
      "color": "#5FE0FF",
      "padding": "10px 14px",
      "text_align": "left",
      "font_weight": "700",
      "border_bottom": "1px solid #382B4B"
    },
    "td": {
      "color": "#EFE6FF",
      "padding": "10px 14px",
      "font_size": "14px",
      "border_bottom": "1px solid #382B4B"
    },
    "list_wrapper": {
      "margin_top": "16px",
      "margin_bottom": "16px"
    },
    "list_item_row": {
      "display": "flex",
      "align_items": "flex-start",
      "margin_bottom": "9px"
    },
    "list_item_bullet": {
      "color": "#FF5FA2",
      "margin_right": "9px",
      "font_weight": "bold",
      "font_size": "15px"
    },
    "ol_item_bullet": {
      "display": "inline-flex",
      "align_items": "center",
      "justify_content": "center",
      "width": "22px",
      "height": "22px",
      "min_width": "22px",
      "background": "rgba(255,95,162,0.12)",
      "color": "#5FE0FF",
      "border_radius": "50%",
      "font_size": "12px",
      "font_weight": "700",
      "margin_right": "10px",
      "margin_top": "4px"
    },
    "list_item_text": {
      "font_size": "16px",
      "color": "#EFE6FF",
      "line_height": "1.9",
      "letter_spacing": "0.4px"
    },
    "footnote_section": {
      "margin_top": "30px",
      "padding_top": "16px",
      "border_top": "1px solid #382B4B"
    },
    "footnote_title": {
      "font_size": "13px",
      "font_weight": "700",
      "color": "#A49AB6",
      "letter_spacing": "0.1em",
      "margin_bottom": "12px"
    },
    "footnote_item": {
      "font_size": "12px",
      "color": "#A49AB6",
      "line_height": "1.7",
      "margin_bottom": "6px",
      "word_break": "break-all"
    },
    "footnote_sup": {
      "font_size": "11px",
      "color": "#FF5FA2",
      "vertical_align": "super",
      "margin_left": "2px"
    },
    "callout": {
      "background": "rgba(255,95,162,0.05)",
      "border_left": "3px solid #FF5FA2",
      "border_radius": "0 14px 14px 0",
      "padding": "14px 18px",
      "margin_top": "20px",
      "margin_bottom": "20px"
    },
    "callout_title": {
      "font_size": "15px",
      "font_weight": "700",
      "color": "#5FE0FF",
      "margin_bottom": "8px"
    },
    "callout_content": {
      "font_size": "15px",
      "color": "#EFE6FF",
      "line_height": "1.8"
    }
  }
}