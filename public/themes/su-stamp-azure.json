    "th": {
      "background": "#2BA3EE",
      "color": "#111111",
      "padding": "10px 14px",
      "text_align": "left",
      "font_weight": "700",
      "border_bottom": "2px solid #111111"
    },
    "td": {
      "color": "#111111",
      "padding": "10px 14px",
      "font_size": "14px",
      "border_bottom": "1px solid rgba(17,17,17,0.18)"
    },
    "list_wrapper": {
      "margin_top": "16px",
      "margin_bottom": "16px"
    },
    "list_item_row": {
      "display": "flex",
      "align_items": "flex-start",
      "margin_bottom": "9px"
    },
    "list_item_bullet": {
      "color": "#111111",
      "margin_right": "9px",
      "font_weight": "900",
      "font_size": "15px"
