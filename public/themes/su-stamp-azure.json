{
  "name": "钢印·湖蓝",
  "description": "墨黑粗边配右下硬投影，湖蓝色块像刚盖下的钢印。适合态度鲜明、要抢注意力的表达。",
  "colors": {
    "primary": "#111111",
    "accent": "#2BA3EE",
    "background": "#FFFFFF",
    "blockquote_bg": "rgba(43,163,238,0.04)",
    "code_bg": "#242424",
    "hr_color": "#646464",
    "footnote_bg": "rgba(43,163,238,0.03)"
  },
  "styles": {
    "wrapper": {
