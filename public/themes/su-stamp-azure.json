    "ol_item_bullet": {
      "display": "inline-flex",
      "align_items": "center",
      "justify_content": "center",
      "width": "22px",
      "height": "22px",
      "min_width": "22px",
      "background": "#2BA3EE",
      "color": "#111111",
      "border_radius": "0",
      "font_size": "12px",
      "font_weight": "700",
      "margin_right": "10px",
      "margin_top": "4px",
      "border": "2px solid #111111",
      "box_shadow": "2px 2px 0 #111111"
    },
    "list_item_text": {
      "font_size": "15px",
      "color": "#111111",
      "line_height": "1.9",
      "letter_spacing": "0.4px"
    },
    "footnote_section": {
      "margin_top": "30px",
      "padding_top": "16px",
      "border_top": "1px solid #DEDEDE"
    },
    "footnote_title": {
      "font_size": "13px",
      "font_weight": "700",
      "color": "#646464",
      "letter_spacing": "0.1em",
      "margin_bottom": "12px"
    },
    "footnote_item": {
      "font_size": "12px",
      "color": "#646464",
      "line_height": "1.7",
      "margin_bottom": "6px",
      "word_break": "break-all"
    },
    "footnote_sup": {
      "font_size": "11px",
      "color": "#2BA3EE",
      "vertical_align": "super",
      "margin_left": "2px"
    },
    "callout": {
      "background": "rgba(43,163,238,0.05)",
      "border_left": "3px solid #2BA3EE",
      "border_radius": "0 0px 0px 0",
      "padding": "14px 18px",
      "margin_top": "20px",
      "margin_bottom": "20px"
    },
    "callout_title": {
      "font_size": "15px",
      "font_weight": "700",
      "color": "#2BA3EE",
      "margin_bottom": "8px"
    },
    "callout_content": {
      "font_size": "15px",
      "color": "#111111",
      "line_height": "1.8"
    }
