{
  "name": "墨纸",
  "description": "极浅暖白底配墨蓝，宋体衬线为主。适合知识整理、方法论。",
  "colors": {
    "primary": "#23262B",
    "accent": "#2A5B86",
    "background": "#F9F8F5",
    "blockquote_bg": "rgba(42,91,134,0.04)",
    "code_bg": "#34373B",
    "hr_color": "#6E7072",
    "footnote_bg": "rgba(42,91,134,0.03)"
  },
  "styles": {
    "wrapper": {
      "background_color": "#F9F8F5",
      "padding": "16px",
      "font_family": "'Songti SC', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif"
    },
    "h1": {
      "font_size": "25px",
      "font_weight": "700",
      "color": "#23262B",
      "text_align": "center",
      "line_height": "1.35",
      "letter_spacing": "0.3em",
      "margin_top": "8px",
      "margin_bottom": "20px",
      "padding": "0"
    },
    "h2": {
      "font_size": "20px",
      "font_weight": "700",
      "color": "#23262B",
      "line_height": "1.35",
      "letter_spacing": "0.3em",
      "margin_top": "32px",
      "margin_bottom": "14px",
      "padding": "0",
      "border_left": "4px solid #2A5B86",
      "padding_left": "12px"
    },
    "h3": {
      "font_size": "17px",
      "font_weight": "700",
      "color": "#2A5B86",
      "line_height": "1.4",
      "margin_top": "26px",
      "margin_bottom": "10px",
      "padding": "0"
    },
    "h4": {
      "font_size": "16px",
      "font_weight": "700",
      "color": "#23262B",
      "line_height": "1.4",
      "margin_top": "22px",
      "margin_bottom": "8px"
    },
    "h5": {
      "font_size": "15px",
      "font_weight": "600",
      "color": "#6E7072",
      "line_height": "1.4",
      "margin_top": "20px",
      "margin_bottom": "6px"
    },
    "h6": {
      "font_size": "14px",
      "font_weight": "600",
      "color": "#6E7072",
      "line_height": "1.4",
      "margin_top": "18px",
      "margin_bottom": "6px"
    },
    "p": {
      "font_size": "16px",
      "color": "#23262B",
      "line_height": "1.9",
      "letter_spacing": "0.4px",
      "text_align": "justify",
      "margin_top": "0",
      "margin_bottom": "20px"
    },
    "strong": {
      "font_weight": "700",
      "color": "#2A5B86"
    },
    "em": {
      "font_style": "italic",
      "color": "#6E7072"
    },
    "a": {
      "color": "#2A5B86",
      "text_decoration": "none",
      "border_bottom": "1px solid rgba(42,91,134,0.5)"
    },
    "blockquote": {
      "border_left": "3px solid #2A5B86",
      "background": "rgba(42,91,134,0.04)",
      "color": "#6E7072",
      "font_size": "15px",
      "line_height": "1.8",
      "padding": "14px 18px",
      "margin_top": "22px",
      "margin_bottom": "22px",
      "border_radius": "0 8px 8px 0"
    },
    "blockquote_p": {
      "font_size": "15px",
      "color": "#6E7072",
      "line_height": "1.8",
      "margin_bottom": "0",
      "background": "transparent",
      "font_style": "normal"
    },
    "img": {
      "max_width": "100%",
      "display": "block",
      "border_radius": "8px",
      "margin_top": "10px",
      "margin_bottom": "10px"
    },
    "img_wrapper": {
      "background": "rgba(35,38,43,0.03)",
      "border_radius": "8px",
      "padding": "4px",
      "margin_top": "12px",
      "margin_bottom": "12px"
    },
    "hr": {
      "border": "none",
      "height": "1px",
      "background": "#DBDBD9",
      "margin_top": "30px",
      "margin_bottom": "30px"
    },
    "code": {
      "background": "rgba(42,91,134,0.09)",
      "color": "#2A5B86",
      "padding": "3px 7px",
      "border_radius": "5px",
      "font_size": "90%",
      "font_family": "'SF Mono', Menlo, Consolas, 'Courier New', monospace"
    },
    "code_block": {
      "background": "#34373B",
      "border_radius": "6px",
      "margin_top": "22px",
      "margin_bottom": "22px",
      "overflow": "hidden"
    },
    "code_header": {
      "display": "none",
      "height": "0",
      "padding": "0"
    },
    "pre": {
      "background": "#34373B",
      "color": "#E6EAF0",
      "padding": "18px",
      "border_radius": "0",
      "overflow_x": "auto",
      "margin_top": "0",
      "margin_bottom": "0",
      "font_size": "13.5px",
      "line_height": "1.6",
      "white_space": "pre-wrap",
      "word_wrap": "break-word",
      "word_break": "break-all"
    },
    "pre_code": {
      "background": "none",
      "padding": "0",
      "color": "#E6EAF0",
      "font_size": "13.5px",
      "font_family": "'SF Mono', Menlo, Consolas, 'Courier New', monospace"
    },
    "table": {
      "width": "100%",
      "border_collapse": "separate",
      "border_spacing": "0",
      "border": "1px solid #DBDBD9",
      "border_radius": "8px",
      "overflow": "hidden",
      "font_size": "14px",
      "margin_top": "18px",
      "margin_bottom": "18px"
    },
    "th": {
      "background": "rgba(42,91,134,0.08)",
      "color": "#2A5B86",
      "padding": "10px 14px",
      "text_align": "left",
      "font_weight": "700",
      "border_bottom": "1px solid #DBDBD9"
    },
    "td": {
      "color": "#23262B",
      "padding": "10px 14px",
      "font_size": "14px",
      "border_bottom": "1px solid #DBDBD9"
    },
    "list_wrapper": {
      "margin_top": "16px",
      "margin_bottom": "16px"
    },
    "list_item_row": {
      "display": "flex",
      "align_items": "flex-start",
      "margin_bottom": "9px"
    },
    "list_item_bullet": {
      "color": "#2A5B86",
      "margin_right": "9px",
      "font_weight": "bold",
      "font_size": "15px"
    },
    "ol_item_bullet": {
      "display": "inline-flex",
      "align_items": "center",
      "justify_content": "center",
      "width": "22px",
      "height": "22px",
      "min_width": "22px",
      "background": "rgba(42,91,134,0.12)",
      "color": "#2A5B86",
      "border_radius": "50%",
      "font_size": "12px",
      "font_weight": "700",
      "margin_right": "10px",
      "margin_top": "4px"
    },
    "list_item_text": {
      "font_size": "16px",
      "color": "#23262B",
      "line_height": "1.9",
      "letter_spacing": "0.4px"
    },
    "footnote_section": {
      "margin_top": "30px",
      "padding_top": "16px",
      "border_top": "1px solid #DBDBD9"
    },
    "footnote_title": {
      "font_size": "13px",
      "font_weight": "700",
      "color": "#6E7072",
      "letter_spacing": "0.1em",
      "margin_bottom": "12px"
    },
    "footnote_item": {
      "font_size": "12px",
      "color": "#6E7072",
      "line_height": "1.7",
      "margin_bottom": "6px",
      "word_break": "break-all"
    },
    "footnote_sup": {
      "font_size": "11px",
      "color": "#2A5B86",
      "vertical_align": "super",
      "margin_left": "2px"
    },
    "callout": {
      "background": "rgba(42,91,134,0.05)",
      "border_left": "3px solid #2A5B86",
      "border_radius": "0 8px 8px 0",
      "padding": "14px 18px",
      "margin_top": "20px",
      "margin_bottom": "20px"
    },
    "callout_title": {
      "font_size": "15px",
      "font_weight": "700",
      "color": "#2A5B86",
      "margin_bottom": "8px"
    },
    "callout_content": {
      "font_size": "15px",
      "color": "#23262B",
      "line_height": "1.8"
    }
  }
}