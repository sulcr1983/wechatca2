  "colors": {
    "primary": "#D9E2EF",
    "accent": "#838F9F",
    "background": "#0B1220",
    "blockquote_bg": "rgba(131,143,159,0.04)",
    "code_bg": "#060A12",
    "hr_color": "#9199A7",
    "footnote_bg": "rgba(131,143,159,0.03)"
  },
  "styles": {
