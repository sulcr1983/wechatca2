    "callout": {
      "background": "rgba(131,143,159,0.05)",
      "border_left": "3px solid #838F9F",
      "border_radius": "0 6px 6px 0",
      "padding": "14px 18px",
      "margin_top": "20px",
      "margin_bottom": "20px"
    },
    "callout_title": {
      "font_size": "15px",
      "font_weight": "700",
      "color": "#ABB3BE",
      "margin_bottom": "8px"
    },
    "callout_content": {
      "font_size": "15px",
      "color": "#D9E2EF",
      "line_height": "1.8"
    }
