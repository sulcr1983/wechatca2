      "margin_top": "22px",
      "margin_bottom": "22px",
      "overflow": "hidden",
      "border": "1px solid rgba(131,143,159,0.25)"
    },
    "code_header": {
      "display": "flex",
      "align_items": "center",
      "height": "36px",
      "padding": "0 12px",
      "background": "#0E1626",
      "border_bottom": "1px solid rgba(131,143,159,0.2)"
    },
    "pre": {
      "background": "#070D18",
      "color": "#C7D5E6",
      "padding": "18px",
      "border_radius": "0",
