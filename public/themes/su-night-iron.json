      "margin_right": "9px",
      "font_weight": "bold",
      "font_size": "15px",
      "font_family": "'SF Mono', Menlo, Consolas, 'Courier New', monospace"
    },
    "ol_item_bullet": {
      "display": "inline-flex",
      "align_items": "center",
      "justify_content": "center",
      "width": "22px",
      "height": "22px",
      "min_width": "22px",
      "background": "rgba(131,143,159,0.14)",
      "color": "#ABB3BE",
      "border_radius": "2px",
      "font_size": "12px",
      "font_weight": "700",
      "margin_right": "10px",
      "margin_top": "4px",
      "font_family": "'SF Mono', Menlo, Consolas, 'Courier New', monospace"
    },
    "list_item_text": {
      "font_size": "15px",
      "color": "#D9E2EF",
      "line_height": "1.9",
      "letter_spacing": "0.4px"
    },
    "footnote_section": {
      "margin_top": "30px",
      "padding_top": "16px",
      "border_top": "1px solid #282F3D"
    },
    "footnote_title": {
      "font_size": "13px",
      "font_weight": "700",
      "color": "#9199A7",
      "letter_spacing": "0.1em",
      "margin_bottom": "12px"
    },
    "footnote_item": {
      "font_size": "12px",
      "color": "#9199A7",
      "line_height": "1.7",
      "margin_bottom": "6px",
      "word_break": "break-all"
    },
    "footnote_sup": {
      "font_size": "11px",
      "color": "#838F9F",
