    "th": {
      "background": "rgba(131,143,159,0.12)",
      "color": "#ABB3BE",
      "padding": "10px 14px",
      "text_align": "left",
      "font_weight": "700",
      "border_bottom": "1px solid #282F3D"
    },
    "td": {
      "color": "#D9E2EF",
      "padding": "10px 14px",
      "font_size": "14px",
      "border_bottom": "1px solid rgba(217,226,239,0.1)"
    },
    "list_wrapper": {
      "margin_top": "16px",
      "margin_bottom": "16px"
    },
    "list_item_row": {
      "display": "flex",
      "align_items": "flex-start",
      "margin_bottom": "9px"
    },
    "list_item_bullet": {
