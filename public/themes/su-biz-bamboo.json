{
  "name": "卷宗·竹青",
  "description": "深色标题块层层收紧，虚线分节，竹青做贯穿始终的定位色。适合周报、复盘与正式方案。",
  "colors": {
    "primary": "#1E2A38",
    "accent": "#2E9464",
    "background": "#FFFFFF",
    "blockquote_bg": "rgba(46,148,100,0.04)",
    "code_bg": "#303B48",
    "hr_color": "#6D757E",
    "footnote_bg": "rgba(46,148,100,0.03)"
  },
  "styles": {
    "wrapper": {
      "background_color": "#FFFFFF",
      "padding": "16px",
      "font_family": "-apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif"
    },
    "h1": {
      "font_size": "25px",
      "font_weight": "800",
      "color": "#1E2A38",
      "text_align": "left",
      "line_height": "1.35",
      "letter_spacing": "0.06em",
      "margin_top": "8px",
      "margin_bottom": "26px",
      "padding": "0",
      "border_bottom": "2px solid #1E2A38",
      "padding_bottom": "12px"
    },
    "h2": {
      "font_size": "20px",
      "font_weight": "800",
      "color": "#FFFFFF",
      "line_height": "1.35",
      "letter_spacing": "0.1em",
      "margin_top": "32px",
      "margin_bottom": "14px",
      "padding": "6px 16px",
      "display": "inline-block",
      "background": "#2E9464",
      "border_radius": "3px"
    },
    "h3": {
      "font_size": "17px",
      "font_weight": "700",
      "color": "#1E2A38",
      "line_height": "1.4",
      "margin_top": "26px",
      "margin_bottom": "10px",
      "padding": "0",
      "border_bottom": "1px dashed rgba(46,148,100,0.45)",
      "padding_bottom": "6px",
      "letter_spacing": "0.05em"
    },
    "h4": {
      "font_size": "16px",
      "font_weight": "700",
      "color": "#1E2A38",
      "line_height": "1.4",
      "margin_top": "22px",
      "margin_bottom": "8px"
    },
    "h5": {
      "font_size": "15px",
      "font_weight": "600",
      "color": "#6D757E",
      "line_height": "1.4",
      "margin_top": "20px",
      "margin_bottom": "6px"
    },
    "h6": {
      "font_size": "14px",
      "font_weight": "600",
      "color": "#6D757E",
      "line_height": "1.4",
      "margin_top": "18px",
      "margin_bottom": "6px"
    },
    "p": {
      "font_size": "16px",
      "color": "#1E2A38",
      "line_height": "1.9",
      "letter_spacing": "0.4px",
      "text_align": "justify",
      "margin_top": "0",
      "margin_bottom": "20px"
    },
    "strong": {
      "font_weight": "700",
      "color": "#267952"
    },
    "em": {
      "font_style": "italic",
      "color": "#6D757E"
    },
    "a": {
      "color": "#2E9464",
      "text_decoration": "none",
      "border_bottom": "1px solid #2E9464"
    },
    "blockquote": {
      "border_left": "4px solid #2E9464",
      "background": "#F5FAF7",
      "color": "#565F6A",
      "font_size": "15px",
      "line_height": "1.8",
      "padding": "14px 18px",
      "margin_top": "22px",
      "margin_bottom": "22px",
      "border_radius": "0 3px 3px 0"
    },
    "blockquote_p": {
      "font_size": "15px",
      "color": "#6D757E",
      "line_height": "1.8",
      "margin_bottom": "0",
      "background": "transparent",
      "font_style": "normal"
    },
    "img": {
      "max_width": "100%",
      "display": "block",
      "border_radius": "3px",
      "margin_top": "10px",
      "margin_bottom": "10px",
      "border": "1px solid #E4E5E7"
    },
    "img_wrapper": {
      "background": "rgba(30,42,56,0.03)",
      "border_radius": "3px",
      "padding": "4px",
      "margin_top": "12px",
      "margin_bottom": "12px"
    },
    "hr": {
      "border": "none",
      "height": "2px",
      "background": "#CED0D3",
      "margin_top": "30px",
      "margin_bottom": "30px"
    },
    "code": {
      "background": "rgba(30,42,56,0.06)",
      "color": "#267952",
      "padding": "3px 7px",
      "border_radius": "3px",
      "font_size": "90%",
      "font_family": "'SF Mono', Menlo, Consolas, 'Courier New', monospace"
    },
    "code_block": {
      "background": "#303B48",
      "border_radius": "3px",
      "margin_top": "22px",
      "margin_bottom": "22px",
      "overflow": "hidden",
      "border": "1px solid rgba(30,42,56,0.1)"
    },
    "code_header": {
      "display": "flex",
      "align_items": "center",
      "height": "36px",
      "padding": "0 12px",
      "background": "#303B48"
    },
    "pre": {
      "background": "#303B48",
      "color": "#E6EAF0",
      "padding": "18px",
      "border_radius": "0",
      "overflow_x": "auto",
      "margin_top": "0",
      "margin_bottom": "0",
      "font_size": "13.5px",
      "line_height": "1.6",
      "white_space": "pre-wrap",
      "word_wrap": "break-word",
      "word_break": "break-all"
    },
    "pre_code": {
      "background": "none",
      "padding": "0",
      "color": "#E6EAF0",
      "font_size": "13.5px",
      "font_family": "'SF Mono', Menlo, Consolas, 'Courier New', monospace"
    },
    "table": {
      "width": "100%",
      "border_collapse": "separate",
      "border_spacing": "0",
      "border": "1px solid #E0E1E3",
      "border_radius": "3px",
      "overflow": "hidden",
      "font_size": "14px",
      "margin_top": "18px",
      "margin_bottom": "18px"
    },
    "th": {
      "background": "#1E2A38",
      "color": "#FFFFFF",
      "padding": "10px 14px",
      "text_align": "left",
      "font_weight": "700",
      "border_bottom": "none"
    },
    "td": {
      "color": "#1E2A38",
      "padding": "10px 14px",
      "font_size": "14px",
      "border_bottom": "1px solid rgba(30,42,56,0.08)"
    },
    "list_wrapper": {
      "margin_top": "16px",
      "margin_bottom": "16px"
    },
    "list_item_row": {
      "display": "flex",
      "align_items": "flex-start",
      "margin_bottom": "9px"
    },
    "list_item_bullet": {
      "color": "#2E9464",
      "margin_right": "9px",
      "font_weight": "700",
      "font_size": "15px"
    },
    "ol_item_bullet": {
      "display": "inline-flex",
      "align_items": "center",
      "justify_content": "center",
      "width": "22px",
      "height": "22px",
      "min_width": "22px",
      "background": "rgba(46,148,100,0.12)",
      "color": "#267952",
      "border_radius": "2px",
      "font_size": "12px",
      "font_weight": "700",
      "margin_right": "10px",
      "margin_top": "4px"
    },
    "list_item_text": {
      "font_size": "16px",
      "color": "#1E2A38",
      "line_height": "1.9",
      "letter_spacing": "0.4px"
    },
    "footnote_section": {
      "margin_top": "30px",
      "padding_top": "16px",
      "border_top": "1px solid #E0E1E3"
    },
    "footnote_title": {
      "font_size": "13px",
      "font_weight": "700",
      "color": "#6D757E",
      "letter_spacing": "0.1em",
      "margin_bottom": "12px"
    },
    "footnote_item": {
      "font_size": "12px",
      "color": "#6D757E",
      "line_height": "1.7",
      "margin_bottom": "6px",
      "word_break": "break-all"
    },
    "footnote_sup": {
      "font_size": "11px",
      "color": "#2E9464",
      "vertical_align": "super",
      "margin_left": "2px"
    },
    "callout": {
      "background": "rgba(46,148,100,0.05)",
      "border_left": "3px solid #2E9464",
      "border_radius": "0 3px 3px 0",
      "padding": "14px 18px",
      "margin_top": "20px",
      "margin_bottom": "20px"
    },
    "callout_title": {
      "font_size": "15px",
      "font_weight": "700",
      "color": "#267952",
      "margin_bottom": "8px"
    },
    "callout_content": {
      "font_size": "15px",
      "color": "#1E2A38",
      "line_height": "1.8"
    }
  }
}