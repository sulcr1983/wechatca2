# 环境变量（含密钥）
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.spec

# 虚拟环境
venv/
.venv/

# 运行时数据
data/
!data/.gitkeep
temp_covers/

# 加密密钥（旧位置，迁移后删除）
data/.secret_key

# 测试截图
tests/**/*.png
tests/**/snapshot.txt
tests/screenshot_*.png

# 运行时生成产物（非源码，可重建）
output/
uploads/
test_output/
temp_covers/

# 私有记忆 / 助手内部数据（绝不入库）
.workbuddy/

# 第三方 vendored 子项目（自带 .git + node_modules，单独管理）
blcaptain-style-skill/

# 本次诊断临时产物（会话级，不入版本库）
reports/
.flask_run.log

# 原型运行时副本（canonical 在 docs/prototypes/，供 Flask /assets/prototypes 预览）
public/prototypes/

# 本地启动脚本
start_app.ps1

# IDE
.vscode/
.idea/

